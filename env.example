# Runtime
NODE_ENV=production
PORT=3000

# Database: current runtime is MySQL/TiDB via drizzle-orm/mysql2.
DATABASE_URL=

# Session signing; use a long random value (at least 32 bytes).
JWT_SECRET=

# Authentication adapter: local, manus, or disabled.
AUTH_PROVIDER=local
VITE_AUTH_PROVIDER=local
LOCAL_AUTH_USER_ID=local-owner
LOCAL_AUTH_USER_NAME=ZadkAI User
LOCAL_AUTH_USER_EMAIL=you@example.com

# Manus OAuth (only when AUTH_PROVIDER=manus).
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# OpenAI-compatible LLM endpoint.
LLM_API_URL=https://api.openai.com
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_PASS_THINKING=false

# Manus Forge compatibility (only when using Manus services).
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# File storage adapter: local, s3, or manus.
STORAGE_PROVIDER=local
STORAGE_DIR=storage/uploads

# S3-compatible storage (only when STORAGE_PROVIDER=s3).
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional map component settings; replace the Manus maps proxy before enabling maps.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
